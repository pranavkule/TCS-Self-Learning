			<x>120.0</x>
			<y>200.0</y>
			<initial/>
		</state>
		<state id="1" name="B">
			<x>340.0</x>
			<y>200.0</y>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>1</to>
