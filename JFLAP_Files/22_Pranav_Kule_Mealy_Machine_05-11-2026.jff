		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
			<transout>0</transout>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>a</read>
			<transout>0</transout>
		</transition>
		<transition>
			<from>1</from>
			<to>0</to>
			<read>b</read>
			<transout>1</transout>
